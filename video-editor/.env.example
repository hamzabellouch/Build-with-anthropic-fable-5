# Required
SONIOX_API_KEY=your-soniox-key
OPENROUTER_API_KEY=your-openrouter-key

# Optional overrides (defaults shown)
# SONIOX_MODEL=stt-async-v3            # user asked for stt-v3; stt-async-v4 is also available
# EDIT_MODEL=openai/gpt-5-mini         # text model for edit decisions (bad takes, Arabic intro copy)
# VIDEO_MODEL=google/gemini-3.5-flash  # video-native model that watches stale stretches
# IMAGE_MODEL=openai/gpt-5.4-image-2   # generates intro backdrop / card illustrations
# MAX_IMAGES=3                         # AI-generated images per video (0 disables — saves money and ~2 min/image)
# SUBSCRIBE_CARD=1                     # 0 = never auto-place the subscribe card
# CHANNEL_NAME=                        # channel name on the subscribe card ('' = generic "اشترك في القناة")
# FONT_DIR=~/.local/share/fonts        # where the Qomra (itf Qomra Arabic) .ttf files live
# LANGUAGE_HINTS=ar,en                 # comma-separated language hints for Soniox
# PORT=4321                            # review UI port
# MOCK=0                               # 1 = run pipeline without any API calls (synthetic transcript/specs)
